{
  "name": "@volly-app/cli",
  "version": "0.2.0",
  "description": "Deploy and manage Volly apps from the terminal",
  "keywords": [
    "cli",
    "deploy",
    "internal-tools",
    "static-site",
    "volly"
  ],
  "homepage": "https://volly.so",
  "license": "MIT",
  "repository": "github:volly-app/volly-cli",
  "bin": {
    "volly": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "clipanion": "^4.0.0-rc.4",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
